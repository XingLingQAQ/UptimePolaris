{
  "name": "uptime-polaris",
  "main": "backends/worker/src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "analytics": { "binding": "ANALYTICS_SQL" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api", "/api/*", "/install.sh", "/install.ps1",
      "/", "/admin", "/admin/*", "/login", "/login/*", "/setup", "/setup/*",
      "/monitor/*", "/status/*", "/server/*",
      "/theme/*", "/polaris-maintenance.js", "/agent/*", "/__scheduled"
    ],
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  },
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true },
  "vars": { "PBKDF2_ITERATIONS": "3000" }
}
