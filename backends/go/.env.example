# Copy to .env in the process working directory. / 复制到进程工作目录的 .env。
POLARIS_ADDR=127.0.0.1:8080
POLARIS_DATA_DIR=./data
# Optional: omit both credentials to generate a temporary setup key.
# 可选：两项凭据均不设置时生成临时初始化密钥。
# POLARIS_SETUP_KEY=replace-with-a-long-random-secret
# POLARIS_ADMIN_TOKEN=replace-with-a-long-random-secret
# POLARIS_DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=verify-full
# Optional frontend override; release binaries otherwise use embedded assets.
# 可选的前端目录；发布版默认使用内嵌资源。
# POLARIS_FRONTEND_DIR=./public
# Agent downloads use the configured GitHub Release repository.
# Agent 下载使用配置的 GitHub Release 仓库。
POLARIS_CONCURRENCY=32
POLARIS_TRUST_PROXY=false
# POLARIS_MIGRATION_TARGET=postgresql://user:password@host:5432/database?sslmode=verify-full
